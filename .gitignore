# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Z-Anatomy source (nặng, không commit)
/zanatomy-src/
*.blend

# Python bytecode sinh ra khi Blender import region_config.py
__pycache__/
*.pyc

# Bản sao lưu do công cụ sinh ra khi sửa file (*.backup-YYYYMMDD-HHMMSS)
*.backup-*
# Log dev server ghi tại gốc dự án
soma-dev.log
