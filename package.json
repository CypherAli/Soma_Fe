{
  "name": "soma-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cms:sync": "node scripts/sync-content-catalog.mjs",
    "verify:cms": "node scripts/sync-content-catalog.mjs --check",
    "dev": "node scripts/next-command.mjs dev",
    "build": "node scripts/next-command.mjs build",
    "start": "next start",
    "lint": "eslint",
    "verify:quiz-bank": "node scripts/verify-quiz-bank.mjs",
    "import:dr-lam": "python scripts/kb/import_dr_lam.py",
    "verify:dr-lam": "node --import ./scripts/ts-resolve.mjs scripts/verify-dr-lam-bank.ts",
    "audit:dr-lam-source": "python scripts/kb/audit_dr_lam_sources.py",
    "verify:dr-lam-images": "python scripts/kb/verify_dr_lam_images.py",
    "audit:quiz-ocr": "node scripts/audit-quiz-ocr.mjs",
    "verify:quiz-text": "node scripts/verify-quiz-text.mjs",
    "verify:scenes": "node scripts/verify-scenes.mjs",
    "test:vet-kb": "node --import ./scripts/ts-resolve.mjs scripts/test-vet-kb.ts && npm run verify:vet-export",
    "test:site-kb": "node --import ./scripts/ts-resolve.mjs scripts/test-site-kb.ts",
    "test:gestures": "node --import ./scripts/ts-resolve.mjs scripts/test-gestures.ts",
    "models:frames": "node scripts/build-model-frames.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "structures": "node scripts/model-structures.mjs",
    "verify:lesions": "node scripts/verify_lesions.mjs",
    "meshes": "node scripts/list_meshes.mjs --json",
    "render:lesions": "node scripts/render_all_lesions.mjs",
    "export:vet": "node --import ./scripts/ts-resolve.mjs scripts/vet/export-vet-data.ts",
    "verify:vet-export": "node --import ./scripts/ts-resolve.mjs scripts/vet/export-vet-data.ts --check",
    "test:vision": "node --import ./scripts/ts-resolve.mjs scripts/test-vision.ts",
    "test:voice": "node --import ./scripts/ts-resolve.mjs scripts/test-voice.ts",
    "test:vision-voice": "node scripts/test-wonder-voice.mjs",
    "test:unit": "node --import ./scripts/ts-resolve.mjs --test \"src/**/*.test.ts\"",
    "test:assistant": "node --import ./scripts/ts-resolve.mjs scripts/test-assistant-quota.mjs && node --import ./scripts/ts-resolve.mjs scripts/test-assistant-latency.mjs",
    "test:wonder": "node --import ./scripts/ts-resolve.mjs scripts/test-wondersnap.ts",
    "test:atlas": "node --import ./scripts/ts-resolve.mjs scripts/test-atlas-framing.ts && node --import ./scripts/ts-resolve.mjs scripts/test-atlas-learning.ts && node --import ./scripts/ts-resolve.mjs scripts/test-region-surface.ts && node --import ./scripts/ts-resolve.mjs scripts/test-scene-labels.ts",
    "test:api-boundary": "node scripts/test-api-boundary.mjs",
    "postinstall": "node scripts/patch-dependencies.cjs",
    "test:security": "node scripts/test-dependency-security.cjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "next": "16.4.2",
    "next-intl": "^4.13.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^11.0.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@donmccurdy/caporal": {
      "glob": "^14.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
